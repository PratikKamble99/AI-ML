df_cleaned = df.copy()


# df_cleaned
df_cleaned = df_cleaned.drop_duplicates()
df_cleaned.shape


df_cleaned.dtypes


df_cleaned["sex"].value_counts() # tells count in categories


# lable encoding
# df_cleaned.head()
df_cleaned["sex"] = df_cleaned["sex"].map({"male":0, "female":1})


df_cleaned = df_cleaned.rename(columns={"sex":"isFemale", "smoker":"isSmoker"})



df_cleaned.head()


df_cleaned["isSmoker"].value_counts() # tells count in categories


df_cleaned["isSmoker"] = df_cleaned["isSmoker"].map({"no":0, "yes":1})


# df_cleaned.head()


# One-hot Encoding
df_cleaned = pd.get_dummies(df_cleaned, columns=["region"], drop_first=True)


df_cleaned.head()


df_cleaned = df_cleaned.astype(int) # Convert all into Int


df_cleaned.head()





df_cleaned['bmi_category'] = pd.cut(df_cleaned['bmi'], bins=[0, 18.5, 24.9, 29.9, float('inf')], labels=["Underweight","Normal","Overweight","obese"])
df_cleaned.head()


df_cleaned = pd.get_dummies(df_cleaned, columns=["bmi_category"], drop_first=True)
df_cleaned.head()


df_cleaned = df_cleaned.astype(int)
df_cleaned.head()






